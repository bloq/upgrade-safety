{
  "name": "@bloq/upgrade-safety",
  "version": "0.1.0",
  "description": "Check a proxy upgrade against the storage layout actually live on chain, including ERC-7201 namespaces",
  "keywords": [
    "upgrades",
    "storage-layout",
    "erc7201",
    "openzeppelin",
    "hardhat",
    "hardhat-deploy"
  ],
  "license": "MIT",
  "author": "Rohit Solia <rohit@bloq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bloq/upgrade-safety"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.0",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "release": "sh scripts/release.sh"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "peerDependencies": {
    "@openzeppelin/upgrades-core": "^1.44.2",
    "hardhat": "^2.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openzeppelin/upgrades-core": "1.44.2",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "hardhat": "^2.29.1",
    "prettier": "^3.9.9",
    "solc": "0.8.30",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
